{
  "name": "living-olive-server",
  "engines": {
    "node": ">=22"
  },
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "postinstall": "node scripts/fix-lockfile-urls.cjs && (node ../scripts/install-hooks.cjs 2>/dev/null || echo '[install-hooks] skipped — not in full repo (Railway/CI)')",
