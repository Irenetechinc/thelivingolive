    "check-lockfiles": "node ../scripts/check-lockfiles.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.19.0",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "openai": "^4.60.0"
  }
