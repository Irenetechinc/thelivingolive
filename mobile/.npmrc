# Ensure npm always resolves packages from the public registry.
# Prevents Replit's internal package-firewall URLs from leaking into
# package-lock.json and breaking EAS Build / Railway CI.
registry=https://registry.npmjs.org/

# Suppress EBADENGINE warnings when running npm install on Node <22.
# The Supabase packages declare engines.node>=22, but they work fine on
# Node 20 at runtime — only native-WebSocket features differ, and we use
# the polyfill. Set this so local dev machines on Node 20 don't get noisy
# warnings that look like failures.
engine-strict=false
